# ============================================================================
# zabt.ai — environment configuration
#
#   cp .env.example .env   then fill the values marked  # REQUIRED
#   docker compose up -d
#
# For a first local run you only need to set 4 things:
#   1. AUTH_JWT_SECRET           (required; generate with the command below)
#   2. OPENAI_API_KEY            (an OpenAI-compatible LLM key, e.g. Ollama Cloud)
#   3. HF_TOKEN                  (Hugging Face token — accept the pyannote gate; see README)
#   4. leave everything else at its default
#
# DO NOT commit your filled-in .env — it is gitignored.
# ============================================================================

# --- Compose profiles -------------------------------------------------------
# "local" = bundled Postgres + MinIO + GPU worker + web UI (single-machine default).
# Add "bot" for the Teams meeting bot, "vision" for visual breakdown.
# Set empty for the cloud/RunPod split (see docker-compose.cloud.yml).
COMPOSE_PROFILES=local

# --- Container memory limits -------------------------------------------------
# Hard per-service caps for ordinary Docker Compose runs. Values use Docker
# memory syntax (m/g); raise an individual cap only when the host can support it.
# The GPU value is a protective cap; the default large-v3 + pyannote workload may
# need a smaller model or a higher explicit override if it is OOM-killed.
ZABT_MEMORY_LIMIT_REDIS=256m
ZABT_MEMORY_LIMIT_API=768m
ZABT_MEMORY_LIMIT_WORKER=1g
ZABT_MEMORY_LIMIT_BEAT=256m
ZABT_MEMORY_LIMIT_DB=768m
ZABT_MEMORY_LIMIT_MINIO=768m
ZABT_MEMORY_LIMIT_MINIO_INIT=128m
ZABT_MEMORY_LIMIT_WORKER_GPU=4g
ZABT_MEMORY_LIMIT_WEB=512m
ZABT_MEMORY_LIMIT_WORKER_BOT=3g
ZABT_MEMORY_LIMIT_QDRANT=512m
ZABT_MEMORY_LIMIT_VISION_WORKER=1g

# --- Database ---------------------------------------------------------------
# Bundled local Postgres (profile "local") credentials:
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=zabt
# REQUIRED. Local default points at the bundled db service. For managed Postgres
# (e.g. Supabase), replace with its asyncpg connection string.
DATABASE_URL=postgresql+asyncpg://app:app@db:5432/zabt

# --- Local authentication ----------------------------------------------------
# Local PostgreSQL stores users and hashed refresh sessions. Web uses HttpOnly cookies;
# mobile uses SecureStore-backed JSON tokens. Generate a secret without storing it in shell history:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Paste the generated value below. This placeholder is intentionally rejected at startup.
AUTH_ENVIRONMENT=development
AUTH_JWT_SECRET=replace-me-with-a-strong-random-secret             # REQUIRED
AUTH_JWT_ISSUER=zabt-api
AUTH_JWT_AUDIENCE=zabt-client
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=15
AUTH_REFRESH_SESSION_EXPIRE_DAYS=30
AUTH_ACCESS_COOKIE_NAME=zabt_access_token
AUTH_REFRESH_COOKIE_NAME=zabt_refresh_token
AUTH_COOKIE_SECURE=false                                          # true behind HTTPS
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_ALLOWED_ORIGINS=http://localhost:3001
BACKEND_CORS_ORIGINS=http://localhost:3001

# --- URLs -------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1                 # browser → API base URL
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3001
APP_URL=http://localhost:3001                                   # used in email deep-links

# --- LLM (summarization) ----------------------------------------------------
# Any OpenAI-compatible endpoint: OpenRouter, OpenAI, LM Studio, Ollama, vLLM, etc.
OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Shared credential for summaries and official OpenAI file transcription when
# TRANSCRIPTION_API_KEY is empty. Custom transcription endpoints use ACTSIS_API_KEY.
OPENAI_API_KEY=your-llm-api-key                                 # REQUIRED
OPENAI_MODEL=google/gemini-3.1-flash-lite-preview

# --- Object storage ---------------------------------------------------------
# "minio" = bundled local MinIO (profile "local"); "s3" = external S3/R2/etc.
STORAGE_PROVIDER=minio
# MinIO (used when STORAGE_PROVIDER=minio):
MINIO_ENDPOINT=minio:9000                                       # in-cluster endpoint
MINIO_PUBLIC_ENDPOINT=http://localhost:9000                     # browser-reachable endpoint (presigned URLs)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=zabt-ai-bucket
MINIO_SECURE=false                                             # true if MinIO/endpoint is served over HTTPS
MINIO_WEBHOOK_SECRET=change-me-in-production                    # shared secret for the MinIO→API upload webhook
# S3 / R2 (used when STORAGE_PROVIDER=s3):
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=zabt-ai-bucket
S3_PUBLIC_URL=
S3_REGION=us-east-1                                         # use auto for Cloudflare R2 or another provider that requires it

# --- Transcription ----------------------------------------------------------
# "gpu-local" = bundled worker-gpu (NVIDIA GPU, or CPU via docker-compose.cpu.yml);
# "runpod" = RunPod Serverless (see docker-compose.cloud.yml).
# TRANSCRIPTION_BACKEND is retained as a local/RunPod compatibility alias.
# For the shareable no-GPU Actsis local profile, keep ACTSIS_API_KEY only in
# the untracked .env copied from this file, then run:
# docker compose --env-file .env -f docker-compose.yml -f docker-compose.local-actsis.yml --profile local up -d
# That overlay applies 7200s timeout / 0 retries / 9000s recovery grace and
# preserves the local API :8000 and web :3001 ports.
TRANSCRIPTION_PROVIDER=gpu-local
# TRANSCRIPTION_BACKEND=gpu-local
TRANSCRIPTION_MODEL=gpt-transcribe
# Audio endpoint for TRANSCRIPTION_PROVIDER=openai-file. The official OpenAI URL
# is the default; custom cloud diarization endpoints must use HTTPS.
TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
# Optional override for openai-file. When empty, the official endpoint uses
# OPENAI_API_KEY and a custom endpoint uses ACTSIS_API_KEY.
# OPENAI_BASE_URL is used for summarization only.
TRANSCRIPTION_API_KEY=
ACTSIS_API_KEY=
TRANSCRIPTION_LANGUAGE=
TRANSCRIPTION_ALLOWED_LANGUAGES=
TRANSCRIPTION_TIMESTAMP_MODE=none
# Optional second OpenAI call (and cost) per file/chunk for playback timing;
# use word for word highlighting.
TRANSCRIPTION_TIMESTAMP_MODEL=whisper-1
# TRANSCRIPTION_TIMESTAMP_MODE=word
TRANSCRIPTION_RESPONSE_FORMAT=json
TRANSCRIPTION_SPEAKER_REQUIRED=false
TRANSCRIPTION_CLOUD_DIARIZATION=false
TRANSCRIPTION_CHUNKING_STRATEGY=
# Custom HTTPS Actsis diarization:
# TRANSCRIPTION_PROVIDER=openai-file
# TRANSCRIPTION_BASE_URL=https://ai.actsis.internal/v1
# TRANSCRIPTION_MODEL=whisper-diarize
# TRANSCRIPTION_CLOUD_DIARIZATION=true
# TRANSCRIPTION_RESPONSE_FORMAT=diarized_json
# TRANSCRIPTION_SPEAKER_REQUIRED=true
# TRANSCRIPTION_CHUNKING_STRATEGY=auto
TRANSCRIPTION_OPENAI_SINGLE_REQUEST_MAX_BYTES=20000000
TRANSCRIPTION_OPENAI_CHUNK_MAX_BYTES=15000000
TRANSCRIPTION_OPENAI_CHUNK_DURATION_SECONDS=600
TRANSCRIPTION_OPENAI_MAX_CHUNKS=1024
TRANSCRIPTION_OPENAI_REQUEST_TIMEOUT_SECONDS=600
TRANSCRIPTION_OPENAI_MAX_RETRIES=2
TRANSCRIPTION_OPENAI_RETRY_BACKOFF_SECONDS=1
TRANSCRIPTION_OPENAI_RETRY_MAX_BACKOFF_SECONDS=8
TRANSCRIPTION_FFMPEG_TIMEOUT_SECONDS=900
# Keep this generic default for non-Actsis processes. Compose's local/full-cloud
# Actsis runtime overrides it to 9000 for the 7200-second request.
# MEETING_RECOVERY_GRACE_SECONDS=900
GPU_SERVICE_URL=http://worker-gpu:8001
# Whisper model size: tiny|base|small|medium|large-v3 (smaller = faster, less accurate).
# Use base/small for CPU-only runs.
WHISPER_MODEL=large-v3
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1              # gated on HF — accept the terms; see README
MEDASR_MODEL=google/medasr                                      # optional medical ASR model
DIARIZATION_MIN_SPEAKERS=1
DIARIZATION_MAX_SPEAKERS=10
# Hugging Face token — REQUIRED for pyannote diarization. Accept the model gate at
# https://huggingface.co/pyannote/speaker-diarization-3.1 then create a token.
HF_TOKEN=your-hugging-face-token                                # REQUIRED (see README: pyannote gate)
# RunPod (used when TRANSCRIPTION_BACKEND=runpod):
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_POLL_INTERVAL=5
RUNPOD_TIMEOUT=1800
# Local GPU/CPU worker timeout in seconds. This is independent from RunPod.
GPU_LOCAL_TIMEOUT=7200

# --- Visual breakdown (optional; profile "vision") --------------------------
# Disabled by default. The backend worker performs direct OpenAI visual inference;
# the legacy vision-worker profile is retained only for compatibility.
# after validating the selected endpoint and its egress policy.
VISION_ENABLED=false
VISION_BACKEND=direct
VISION_INFERENCE_BACKEND=ollama
VISION_LOCAL_URL=http://zabt-vision-worker:8003                         # legacy standalone worker only
VISION_JUDGE_MODEL=qwen3-vl:8b-thinking
# OpenAI vision is an explicit alternative. Use a separate OpenAI key here when
# VISION_OPENAI_BASE_URL points to api.openai.com. OPENAI_API_KEY above may target
# OpenRouter or another summary provider and is intentionally not reused.
VISION_OPENAI_API_KEY=
VISION_OPENAI_BASE_URL=https://api.openai.com/v1
VISION_OPENAI_MODEL=gpt-4o-mini
VISION_OPENAI_IMAGE_DETAIL=low                            # low|auto|high
VISION_OPENAI_MAX_TOKENS=1024
OLLAMA_HOST=http://host.docker.internal:11434                   # Ollama host serving the vision model
OLLAMA_NO_CLOUD=1                                               # keep Ollama inference local
VISION_REQUIRE_VISION=true
VISION_MAX_RETRIES=2
VISION_RETRY_BACKOFF_SECONDS=5
# Cloud access is disabled by default. OpenAI mode requires explicitly setting
# all three values below in the deployment environment.
VISION_CLOUD_ALLOWED=false                                     # set true only for explicit OpenAI cloud use
VISION_EGRESS_POLICY=deny                                      # deny|allowlist|allow
VISION_ALLOWED_HOSTS=                                          # set api.openai.com for the OpenAI endpoint
# Compose writes visual keyframes and raw output to the bundled MinIO by default
# (http://minio:9000, us-east-1, minioadmin, zabt-ai-bucket). Explicit S3_* values
# in the object-storage section override those vision-worker fallbacks.
VISION_SIGNED_URL_EXPIRATION=3600
VISION_RUNPOD_API_KEY=
VISION_RUNPOD_ENDPOINT_ID=
VISION_POLL_INTERVAL=5
VISION_TIMEOUT=1800
SUMMARY_CHUNK_SECONDS=120
SUMMARY_MAX_INPUT_TOKENS=6000

# --- Microsoft Graph delegated integration (optional) -----------------------
# These deployment-managed values are used only for the server-side Graph
# OAuth flow. They are separate from public SPA OIDC configuration, which an
# administrator saves from the frontend and which never needs a client secret.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/integrations/microsoft/callback
MICROSOFT_OIDC_HTTP_TIMEOUT_SECONDS=10
# Fernet key encrypting stored OAuth tokens at rest. REQUIRED if you enable integrations.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Teams meeting bot (optional; profile "bot") ----------------------------
BOT_DISPLAY_NAME=Zabt AI Notetaker
BOT_WORKER_URL=http://worker-bot:8002

# --- Email (Resend, optional) -----------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@zabt.ai

# --- Notifications (optional) -----------------------------------------------
# NOTIFICATION_PROVIDER: "telegram", "multi", or empty to disable.
NOTIFICATION_PROVIDER=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Observability (all optional) -------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
LOGFIRE_TOKEN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Mobile app (optional; only if building the Expo app) -------------------
EXPO_ACCESS_TOKEN=
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
# Mobile local authentication uses the API and SecureStore; no Supabase values are needed.

# Custom OpenAI-compatible gateways such as Actsis can opt in to full-file transcription uploads.
# Keep 0 for official OpenAI and default custom-gateway chunking behavior.
TRANSCRIPTION_DIRECT_UPLOAD_MAX_BYTES=0
# System superuser bootstrap: required for first API startup. Store real values
# only in a secret-managed .env or deployment secret manager; never commit them.
# Once provisioned, container restarts do not reset this account's password.
BOOTSTRAP_SUPERUSER_EMAIL=
BOOTSTRAP_SUPERUSER_PASSWORD=
