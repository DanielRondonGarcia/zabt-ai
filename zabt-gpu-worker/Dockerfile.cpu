# CPU Worker: slim Python runtime + CPU-only ML deps via uv
# Models download at first startup (not baked in)
FROM python:3.12-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# Debian runtime packages for audio decoding and CPU PyTorch's OpenMP support.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Install uv (pinned version for reproducible builds)
COPY --from=ghcr.io/astral-sh/uv:0.7.8 /uv /uvx /bin/

WORKDIR /app

# Copy dependency files (cached layer — rebuilds only when deps change)
COPY pyproject.toml uv.lock ./

# Install dependencies with the explicit CPU extra and cache mount for faster retries
ENV UV_HTTP_TIMEOUT=1200
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project --extra cpu

# Activate venv via PATH
ENV PATH="/app/.venv/bin:$PATH"

# Copy source code (fast layer — rebuilds on every code change)
COPY scripts/ scripts/
COPY src/ src/

EXPOSE 8001

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s \
    CMD python -c "import httpx; httpx.get('http://localhost:8001/health')" || exit 1

CMD ["python", "-m", "src.main"]
