# Copy these names into the deployment secret manager or an untracked env file.
# Use docker-compose.full-cloud.yml; do not combine it with another Compose file.

ZABT_API_IMAGE=ghcr.io/<owner>/zabt-ai-api:<immutable-release>
ZABT_WORKER_IMAGE=ghcr.io/<owner>/zabt-ai-worker:<immutable-release>
ZABT_WEB_IMAGE=ghcr.io/<owner>/zabt-ai-web:<immutable-release>

DATABASE_URL=postgresql+asyncpg://<user>:<password>@<managed-postgres-host>:5432/<database>
REDIS_URL=rediss://:<password>@<managed-redis-host>:6380/0

# Must be at least 32 bytes and contain at least 12 distinct characters.
AUTH_JWT_SECRET=<random-secret-at-least-32-bytes-and-12-distinct-characters>
AUTH_ALLOWED_ORIGINS=https://<web-domain>
BACKEND_CORS_ORIGINS=https://<web-domain>
APP_URL=https://<web-domain>
NEXT_PUBLIC_API_URL=https://<api-domain>/api/v1
NEXT_PUBLIC_FRONTEND_URL=https://<web-domain>

STORAGE_PROVIDER=s3
S3_ENDPOINT_URL=https://<s3-endpoint>
S3_PUBLIC_URL=https://<browser-reachable-s3-endpoint>
S3_ACCESS_KEY_ID=<s3-access-key>
S3_SECRET_ACCESS_KEY=<s3-secret-key>
S3_BUCKET_NAME=<s3-bucket>
S3_REGION=auto

ACTSIS_API_KEY=<actsis-key>
ACTSIS_CA_BUNDLE=/usr/local/share/ca-certificates/actsis-root-ca.crt
TRANSCRIPTION_BASE_URL=https://<actsis-host>/v1
TRANSCRIPTION_MODEL=whisper-1
TRANSCRIPTION_RESPONSE_FORMAT=json
EMBEDDING_BASE_URL=https://<actsis-host>/v1
EMBEDDING_MODEL=<actsis-embedding-model>
EMBEDDING_DIMENSION=<embedding-dimension>

QDRANT_URL=https://<managed-qdrant-host>
QDRANT_API_KEY=<qdrant-api-key>

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=<summary-and-intelligence-key>
OPENAI_MODEL=gpt-4o-mini
AI_CHAT_BASE_URL=https://api.openai.com/v1
AI_CHAT_MODEL=gpt-4o-mini
# Optional: when empty, retrieval chat uses OPENAI_API_KEY by design.
AI_CHAT_API_KEY=

VISION_OPENAI_API_KEY=<dedicated-visual-inference-key>
VISION_OPENAI_BASE_URL=https://api.openai.com/v1
VISION_OPENAI_MODEL=gpt-4o-mini
VISION_ALLOWED_HOSTS=api.openai.com
